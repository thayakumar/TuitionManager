# Local isolated SQLite. Run mkdir -p data before migration/startup.
TURSO_DATABASE_URL=file:./data/tuition.db
TURSO_AUTH_TOKEN=
# Optional integrations: configure secure values in environment settings.
# APPS_SCRIPT_UPLOAD_URL=
# JAAS_APP_ID=
# JAAS_API_KEY_ID=
# JAAS_PRIVATE_KEY=
# Required in Vercel Production for scheduled monthly draft invoices.
# Generate a long random value; Vercel sends it as Authorization: Bearer.
# CRON_SECRET=

# Optional: canonical site origin for MCP OAuth/custom domains. Local tests may use loopback HTTP.
# MCP_PUBLIC_URL=https://tuition-manager-dusky.vercel.app
